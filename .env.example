# Amdahl Cookbook environment template.
# Copy this file to `.env` and fill in your real values.
# Recipes load this file automatically via `dotenv/config`.

# Recipes 01-03 hit the public docs MCP at app.amdahl.co/mcp/public.
# No auth required. Optional override:
AMDAHL_MCP_PUBLIC_URL=https://app.amdahl.co/mcp/public

# Recipes 04+ hit the tenant MCP and require an API key.
# Generate one in the Amdahl Console under Team Settings -> MCP Keys.
AMDAHL_MCP_URL=https://app.amdahl.co/mcp
AMDAHL_API_KEY=

# Recipe 05 (Claude with Amdahl MCP) needs an Anthropic key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

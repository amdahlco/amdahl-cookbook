# Amdahl Cookbook environment template.
# Copy this file to `.env` and fill in your real values.
# Recipes load this file automatically via `dotenv/config`.

# Your Amdahl API key. Generate one at https://app.amdahl.co/settings/api-keys.
# Format: ak_live_... (production) or ak_test_... (staging)
AMDAHL_API_KEY=ak_live_your_key_here

# Base URL for the Amdahl Platform API.
# Defaults to https://app.amdahl.co for production. Override for staging or local.
AMDAHL_API_BASE=https://app.amdahl.co

# Your Amdahl business UUID. Find it in the console URL after `/business/`.
# Required because every API call is scoped to a single business.
AMDAHL_BUSINESS_ID=00000000-0000-0000-0000-000000000000
